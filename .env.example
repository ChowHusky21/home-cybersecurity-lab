# Example environment file for reproducing this lab's target containers.
# Copy this to `.env`, fill in your own values, and pass it to Docker with
# `docker run --env-file .env ...` — never commit the real `.env` file.
# See docs/target-services.md for which variable applies to which container.

# SSH weak-credential target
USER_PASSWORD=

# OWASP WebGoat — some lessons issue JWTs whose validity depends on the
# container clock matching a real timezone
TZ=
